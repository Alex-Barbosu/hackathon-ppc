{
  "uid": "filegrid-storages",
  "title": "FileGrid Storages",
  "description": "PostgreSQL, S3 and FTP as FileGrid sees them: reachable, circuit, spool, speed and failures per storage, fallback writes.",
  "tags": [
    "filegrid"
  ],
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "filegrid"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "FileGrid"
    }
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "category",
        "label": "Category",
        "type": "custom",
        "query": "meter,outage,document,video",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "meter",
            "value": "meter",
            "selected": false
          },
          {
            "text": "outage",
            "value": "outage",
            "selected": false
          },
          {
            "text": "document",
            "value": "document",
            "selected": false
          },
          {
            "text": "video",
            "value": "video",
            "selected": false
          }
        ]
      },
      {
        "name": "storage",
        "label": "Storage",
        "type": "custom",
        "query": "db,s3,ftp,spool",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "db",
            "value": "db",
            "selected": false
          },
          {
            "text": "s3",
            "value": "s3",
            "selected": false
          },
          {
            "text": "ftp",
            "value": "ftp",
            "selected": false
          },
          {
            "text": "spool",
            "value": "spool",
            "selected": false
          }
        ]
      },
      {
        "name": "op",
        "label": "Op",
        "type": "custom",
        "query": "write,read,verify",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "write"
          ],
          "value": [
            "write"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": false
          },
          {
            "text": "write",
            "value": "write",
            "selected": true
          },
          {
            "text": "read",
            "value": "read",
            "selected": false
          },
          {
            "text": "verify",
            "value": "verify",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 30,
      "type": "row",
      "title": "Storages: which are reachable, and what waits for them",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 31,
      "type": "stat",
      "title": "Storage reachable",
      "description": "filegrid_storage_up: last health probe of each storage by filegrid-api.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (storage) (filegrid_storage_up)",
          "legendFormat": "{{storage}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "no traffic yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Storage cut off (circuit breaker)",
      "description": "filegrid_circuit_open: OPEN means filegrid-api stopped calling this storage and routes to the fallback.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (storage) (filegrid_circuit_open)",
          "legendFormat": "{{storage}}"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "no traffic yet",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green"
                },
                "1": {
                  "text": "OPEN",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Files waiting for their storage (spool)",
      "description": "filegrid_spool_pending: items parked in the fallback spool, waiting for their storage to return.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (category) (filegrid_spool_pending)",
          "legendFormat": "{{category}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "no traffic yet",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Save and download time per storage (95 % within)",
      "description": "p95 of filegrid_op_duration_seconds by storage and op (write, read), all categories together. Dots are sampled requests: click one to open its trace.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, storage, op) (rate(filegrid_op_duration_seconds_bucket{op=~\"write|read\"}[$__rate_interval])))",
          "legendFormat": "{{storage}} · {{op}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "no traffic yet",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "Failing operations per storage",
      "description": "filegrid_ops_total: outcome=error / all operations, per storage. A dead storage shows here first, before its circuit opens.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (storage) (rate(filegrid_ops_total{outcome=\"error\"}[$__rate_interval])) or sum by (storage) (rate(filegrid_ops_total[$__rate_interval])) * 0)\n/ sum by (storage) (rate(filegrid_ops_total[$__rate_interval]))",
          "legendFormat": "{{storage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "no traffic yet",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Saved to the fallback storage instead",
      "description": "filegrid_ops_total outcome=fallback: the primary storage refused and the policy's fallback took the write.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (category, storage) (rate(filegrid_ops_total{category=~\"$category\", storage=~\"$storage\", op=~\"$op\", outcome=\"fallback\"}[$__rate_interval]))",
          "legendFormat": "{{category}} · {{storage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "no traffic yet",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
