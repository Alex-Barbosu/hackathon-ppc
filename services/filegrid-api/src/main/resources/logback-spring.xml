<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console: JSON, in the format named by logging.structured.format.console in application.yml (Boot's own
  console-appender.xml only knows plain text, so the structured encoder is wired here). The field renames
  (traceId to trace_id, spanId to span_id) come from logging.structured.json.rename.*.

  OTLP: the same lines, sent to the OpenTelemetry collector and from there to Loki. See OtlpLogAppender.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>${CONSOLE_LOG_STRUCTURED_FORMAT}</format>
        </encoder>
    </appender>

    <appender name="OTLP" class="ro.ppc.filegrid.observability.OtlpLogAppender">
        <!-- Debug lines would be a lot of traffic for no use in Loki. -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTLP"/>
    </root>
</configuration>
