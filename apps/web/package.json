{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zone C: FileGrid web app",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "textures": "node tools/render-textures.mjs",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.d.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@uppy/core": "^6.3.1",
    "@uppy/tus": "^6.0.1",
    "framer-motion": "^14.14.0",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "three": "^0.169.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "6.3.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
