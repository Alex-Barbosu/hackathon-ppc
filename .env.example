# Copied to .env by `make up` (scripts/init-env.sh). Every __GENERATE__ becomes a random
# secret on first run. Never commit .env. Zones ask zone B to add new keys here.

# Public host name served by Caddy (TLS via its local CA).
FILEGRID_HOST=localhost

# Storages (zone B)
POSTGRES_PASSWORD=__GENERATE__
INSIGHTS_DB_PASSWORD=__GENERATE__
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
FTP_PASSWORD=__GENERATE__

# FileGrid API (zone A)
FILEGRID_MASTER_KEY=__GENERATE__
JWT_SECRET=__GENERATE__
# Password for every demo user (field, dispatch, connections, admin).
DEMO_PASSWORD=__GENERATE__
METER_DEVICE_TOKEN=__GENERATE__

# Chaos control (zone B) mounts the Docker socket. Rootless Docker or a custom path:
# DOCKER_HOST_SOCKET=/run/user/1000/docker.sock
# Observability (zone B)
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# Meter simulator (zone B). Base points at the mock API.
# Real ingest (zone A). For the Prism mock: http://mock-api:4010/api/v1/meter-readings
METER_TARGET_URL=http://caddy:8088/api/v1/meter-readings
METER_READINGS_PER_SEC=1
METER_COUNT=500
# normal | peak (peak = 10x METER_READINGS_PER_SEC)
METER_PROFILE=normal

# Insights (zone C). Optional: AI features show "missing key" without it.
ANTHROPIC_API_KEY=
